# config.yaml — Configuração global do LILO
# Lido por shared/utils.py e subagentes.
# Variáveis de ambiente no .env têm precedência sobre este arquivo.

lilo:
  version: "7.0.0"
  name: "LILO"
  description: "Agente pessoal integrado — bioinformática e ciência de dados"
  log_level: "INFO"          # DEBUG | INFO | WARNING | ERROR

# ── Backends LLM ──────────────────────────────────────────────────────────────
llm:
  # Prioridade: litellm → ollama → anthropic
  default_model: "llama3.1:8b"
  timeout_seconds: 120
  temperature: 0.3
  max_tokens: 2048

  ollama:
    host: "http://localhost:11434"
    models:
      # Nomes exatos conforme `ollama list`
      planner:    "phi3:14b-medium-128k-instruct-q4_K_M"   # Planner/Critic
      code:       "qwen2.5-coder:14b"                       # Executor código ⭐
      chat:       "llama3.1:8b-instruct-q8_0"              # Chat geral
      autocomplete: "qwen2.5-coder:7b-instruct"            # Autocomplete leve
      embed:      "mxbai-embed-large:latest"               # Embeddings

  litellm:
    host: "http://localhost:4000"
    api_key: <DEFINIR_FORA_DO_GIT>

  anthropic:
    model_sonnet: "claude-sonnet-4-20250514"
    model_opus: "claude-opus-4-20250514"
    # api_key: <DEFINIR_FORA_DO_GIT>

  # Policy Engine — roteamento custo-inteligente
  policy:
    daily_budget_usd: 1.0       # LILO_DAILY_BUDGET
    allow_cloud: true            # LILO_ALLOW_CLOUD
    # tiers: no_llm → ollama_fast → ollama → ollama_heavy → claude_sonnet → claude_opus

# ── Subagentes ────────────────────────────────────────────────────────────────
agents:
  sql:
    enabled: true
    db_default: ""             # caminho sqlite padrão (deixar vazio para perguntar)

  pdf:
    enabled: true
    data_dir: "PDFs_library/data"
    max_file_size_mb: 50
    default_mode: "simple"    # simple | introduction | methods

  scholar:
    enabled: true
    default_source: "auto"    # auto | pubmed | arxiv
    max_results: 5

  gateway:
    enabled: true
    default_mode: "chat"      # chat | code | bioinfo | sql

# ── Servidor MCP ──────────────────────────────────────────────────────────────
mcp:
  claude_desktop: "lilo_mcp.py"        # JSON-RPC stdin/stdout
  pycharm: "lilo_pycharm_mcp.py"       # FastMCP (LILO + Villa Lobos)
  http_server: "lilo_serve.py"         # multiplexer: --transport http (lilo_server.py arquivado em _ARCHIVE_v10)
  pythonpath: "C:\\Users\\luizd\\OneDrive\\Data_Science\\Projetos\\IA.agente"

# ── Integrações ──────────────────────────────────────────────────────────────
integrations:
  obsidian:
    vault: "C:/Users/luizd/obsidion/00_SYSTEM/vault_system"
    folder: "LILO"
    # Configurar em .env: OBSIDIAN_VAULT, OBSIDIAN_LILO_FOLDER

  villa_lobos:
    path: "C:\\Users\\luizd\\OneDrive\\Data_Science\\Projetos\\osquestrador_ollama\\villa_lobos"

# ── Paths do projeto ──────────────────────────────────────────────────────────
paths:
  root:     "C:\\Users\\luizd\\OneDrive\\Data_Science\\Projetos\\IA.agente"
  logs:     "logs"
  shared:   "shared"
  pdfs:     "PDFs_library/data"
