{
  "name": "openmm_nvt_equilibration_safe",
  "description": "Gera um script OpenMM de equilibração NVT com práticas anti-NaN: minimização de energia, aquecimento gradual em rampas, HBonds constraints, HMR (timestep 2 fs estável). Resolve o erro 'Particle coordinate is NaN'.",
  "tags": ["bioinformatica", "molecular_dynamics", "openmm"],
  "complexity": "medium",
  "module": "skills/bio/openmm_nvt_equilibration_safe.py",
  "qualified_name": "lilo.bio.openmm_nvt_equilibration_safe",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pdb_path": {
        "type": "string",
        "description": "Caminho do PDB de entrada (proteína já preparada ou crua)."
      },
      "output_script": {
        "type": "string",
        "description": "Caminho do script Python a gerar.",
        "default": "run_nvt.py"
      },
      "target_temp_k": {
        "type": "number",
        "description": "Temperatura alvo em Kelvin (default 310.0 = ~37 °C).",
        "default": 310.0
      },
      "ph": {
        "type": "number",
        "description": "pH para Modeller.addHydrogens.",
        "default": 7.4
      },
      "forcefield": {
        "type": "string",
        "description": "Arquivo do force field OpenMM.",
        "default": "amber14-all.xml"
      },
      "water_model": {
        "type": "string",
        "description": "Modelo de água OpenMM.",
        "default": "amber14/tip3pfb.xml"
      },
      "padding_nm": {
        "type": "number",
        "description": "Padding da caixa em nm.",
        "default": 1.2
      },
      "timestep_fs": {
        "type": "number",
        "description": "Passo de integração em fs (2.0 com HBonds+HMR).",
        "default": 2.0
      },
      "equilibration_ns": {
        "type": "number",
        "description": "Duração da equilibração NVT em ns.",
        "default": 1.0
      }
    },
    "required": ["pdb_path"]
  }
}
