# Dockerfile.api — imagem do agente híbrido LILO (lilo_api.py)
# V10.3 (2026-05-31). Build leve: só as deps de runtime da API + agentes.
FROM python:3.11-slim

WORKDIR /app

# curl para healthcheck e libs nativas mínimas
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Instala dependências primeiro (cache de camada). requirements.txt na raiz.
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Código entra via bind-mount no compose (./:/app) p/ dev rápido; em build
# standalone, descomente a linha abaixo para empacotar o código na imagem.
# COPY . /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LILO_SERVER_PROFILE=desktop_dev

EXPOSE 8000

CMD ["uvicorn", "lilo_api:app", "--host", "0.0.0.0", "--port", "8000"]
