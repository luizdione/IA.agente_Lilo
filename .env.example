# ============================================================
# LILO v7.0 — Configuração (.env.example)
# Copie para .env e preencha suas chaves
# ============================================================

# ── LLM Backends ─────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0
OLLAMA_MODEL_CODE=qwen2.5-coder:14b
OLLAMA_MODEL_PLAN=phi3:14b-medium-128k-instruct-q4_K_M
OLLAMA_MODEL_FAST=qwen2.5-coder:7b-instruct
OLLAMA_MODEL_EMBED=mxbai-embed-large:latest

LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LILO ─────────────────────────────────────────────────────
LILO_VERSION=7.0.0
DEBUG=false
LLM_TIMEOUT=120

# ── Policy Engine ────────────────────────────────────────────
LILO_DAILY_BUDGET=1.0
LILO_ALLOW_CLOUD=true

# ── Obsidian ─────────────────────────────────────────────────
OBSIDIAN_VAULT=
OBSIDIAN_LILO_FOLDER=LILO

# ── Subagentes ───────────────────────────────────────────────
PDF_DIR=./PDFs_library/data
