# ============================================================
# LILO v10.1 — Configuração (.env.example)
# Copie para .env e preencha suas chaves
# ============================================================

# ── LLM Backends: Ollama (local) ─────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0
OLLAMA_MODEL_CODE=qwen2.5-coder:14b
OLLAMA_MODEL_PLAN=phi3:14b-medium-128k-instruct-q4_K_M
OLLAMA_MODEL_FAST=qwen2.5-coder:7b-instruct
OLLAMA_MODEL_EMBED=mxbai-embed-large:latest
# Modelo permanece em VRAM por 2h (evita reload)
OLLAMA_KEEP_ALIVE=2h

# ── LLM Backends: LiteLLM proxy (opcional) ───────────────────
# Roteamento centralizado de Anthropic/OpenAI/Ollama via :4000
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=

# ── LLM Backends: Cloud (chaves) ─────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Modelos Claude (override sem editar codigo) ──────────────
# Lidos por shared/llm_client.py e shared/policy.py
LILO_CLAUDE_HAIKU=claude-haiku-4-5
LILO_CLAUDE_SONNET=claude-sonnet-4-5
LILO_CLAUDE_OPUS=claude-opus-4-5

# ── LILO core ────────────────────────────────────────────────
LILO_VERSION=10.1.0
DEBUG=false
LLM_TIMEOUT=120

# ── Policy Engine (controle de custos) ───────────────────────
LILO_DAILY_BUDGET=1.0
LILO_ALLOW_CLOUD=true

# ── lilo_api.py (FastAPI HTTP) ───────────────────────────────
# Servidor HTTP do LILO em http://LILO_API_HOST:LILO_API_PORT
LILO_API_HOST=0.0.0.0
LILO_API_PORT=8088
# Token Bearer opcional (modo dev: deixe vazio).
# Em producao: gere com `python -c "import secrets; print(secrets.token_urlsafe(32))"`
LILO_API_TOKEN=
# CORS: dominios permitidos separados por virgula (* = aberto)
LILO_API_CORS=*

# ── Pesquisa externa (shared/research_sources.py, V10.4) ─────
# Fontes PUBLICAS, sem chave obrigatoria (paridade com o Claude):
#   pubmed, arxiv, clinicaltrials, opentargets, npi, crossref, semanticscholar
# As variaveis abaixo sao OPCIONAIS e so melhoram limites/etiqueta:
#   NCBI_API_KEY            -> eleva PubMed de 3 p/ 10 req/s (gratis em ncbi.nlm.nih.gov/account)
#   LILO_RESEARCH_EMAIL     -> e-mail de contato (polidez em PubMed/Crossref)
#   SEMANTIC_SCHOLAR_API_KEY-> remove o HTTP 429 do Semantic Scholar publico
#   LILO_RESEARCH_TIMEOUT   -> timeout por chamada (s), default 15
NCBI_API_KEY=
LILO_RESEARCH_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
LILO_RESEARCH_TIMEOUT=15

# ── Obsidian ─────────────────────────────────────────────────
OBSIDIAN_VAULT=
OBSIDIAN_LILO_FOLDER=LILO

# ── Subagentes ───────────────────────────────────────────────
PDF_DIR=./PDFs_library/data

# ── Memoria persistente (KV SQLite v10.3) ────────────────────
# Caminho do banco SQLite. Default fica fora do OneDrive para evitar
# "disk I/O error" e locks de sync:
#   Windows: %LOCALAPPDATA%\LILO\memory\kv_memory.db
#   Unix:    ~/.local/share/lilo/memory/kv_memory.db
# Override:
# LILO_KV_MEMORY_DB=D:\dados\lilo\kv_memory.db

# ── Desktop Commander (allow-list de paths) ──────────────────
# Tools fs_read/write/list/search e run_shell ficam restritas a estes paths.
# Separador: ; (Windows) ou : (Unix). Default: raiz do projeto LILO.
LILO_DESKTOP_ALLOW=C:\\Users\\luizd\\OneDrive\\Data_Science\\Projetos\\IA.agente;D:\\OneDrive\\Documentos\\Workaholics

# ── Villa_Lobos -- tiers por estagio (override via .env) ─────
# Cada estagio do pipeline (orchestrator/planner/reader/worker/reporter)
# resolve para um backend via Policy Engine. Valores aceitos:
#   ollama_fast | ollama_chat | ollama_plan | ollama_code | ollama_heavy
#   claude_haiku | claude_sonnet | claude_opus
# Defaults sao locais (Ollama). Para usar Claude no Reporter (qualidade
# em sintese), por exemplo:
#   VILLA_TIER_REPORTER=claude_haiku
# VILLA_TIER_ORCHESTRATOR=ollama_fast
# VILLA_TIER_PLANNER=ollama_plan
# VILLA_TIER_READER=ollama_code
# VILLA_TIER_WORKER=ollama_code
# VILLA_TIER_REPORTER=ollama_chat
