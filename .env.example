# ============================================================
# LILO v10.1 — Configuração (.env.example)
# Copie para .env e preencha suas chaves
# ============================================================

# ── LLM Backends: Ollama (local) ─────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0
OLLAMA_MODEL_CODE=qwen2.5-coder:14b
OLLAMA_MODEL_PLAN=phi3:14b-medium-128k-instruct-q4_K_M
OLLAMA_MODEL_FAST=qwen2.5-coder:7b-instruct
OLLAMA_MODEL_EMBED=mxbai-embed-large:latest
# Modelo permanece em VRAM por 2h (evita reload)
OLLAMA_KEEP_ALIVE=2h

# ── LLM Backends: LiteLLM proxy (opcional) ───────────────────
# Roteamento centralizado de Anthropic/OpenAI/Ollama via :4000
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=

# ── LLM Backends: Cloud (chaves) ─────────────────────────────
ANTHROPIC_API_KEY=
# Reservada ao LiteLLM proxy (entradas openai/* no model_list); o codigo do
# LILO NAO le esta variavel diretamente (V18 QW7).
OPENAI_API_KEY=

# ── Modelos Claude (override sem editar codigo) ──────────────
# Lidos por shared/llm_client.py e shared/policy.py
LILO_CLAUDE_HAIKU=claude-haiku-4-5
LILO_CLAUDE_SONNET=claude-sonnet-4-5
LILO_CLAUDE_OPUS=claude-opus-4-5

# ── LILO core ────────────────────────────────────────────────
LILO_VERSION=10.1.0
DEBUG=false
# Timeout (s) das chamadas LLM. Alinhado ao default do codigo na V18 QW7
# (o exemplo antigo dizia 120, mas shared/llm_client.py usa 300 quando ausente).
LLM_TIMEOUT=300
# Retry transitorio do llm_client (V16): tentativas EXTRAS e base do backoff exp.
LILO_LLM_RETRIES=2
LILO_LLM_BACKOFF=1.5
# Prompt caching nos blocos system da Anthropic (V17; =0 desliga)
LILO_ANTHROPIC_CACHE=1

# ── Policy Engine (controle de custos) ───────────────────────
LILO_DAILY_BUDGET=1.0
# V18 QW3: LILO_ALLOW_CLOUD agora e LIDA de fato (era letra morta desde a
# criacao): nuvem = flag ligada E ANTHROPIC_API_KEY presente. =false desliga
# o cloud sem precisar remover a chave do .env.
LILO_ALLOW_CLOUD=true
# V18 QW3: teto de custo POR CHAMADA (antes lido e nunca aplicado)
LILO_MAX_SINGLE_COST=0.50
# Telemetria de custo (SQLite). Default: <raiz>/logs/cost_tracking.db
# LILO_COST_DB=D:\dados\lilo\cost_tracking.db
# Perfil de servidor (policy + conjunto de tools MCP; ver config/profiles.yaml)
# LILO_SERVER_PROFILE=desktop_dev

# ── lilo_api.py (FastAPI HTTP) ───────────────────────────────
# Servidor HTTP do LILO em http://LILO_API_HOST:LILO_API_PORT
LILO_API_HOST=0.0.0.0
LILO_API_PORT=8088
# Token Bearer opcional (modo dev: deixe vazio).
# Em producao: gere com `python -c "import secrets; print(secrets.token_urlsafe(32))"`
LILO_API_TOKEN=
# CORS: dominios permitidos separados por virgula (* = aberto)
LILO_API_CORS=*

# ── Pesquisa externa (shared/research_sources.py, V10.4 + V12.2) ─────
# 10 fontes PUBLICAS, sem chave obrigatoria:
#   pubmed, arxiv, europepmc, openalex, crossref, semanticscholar,
#   googlebooks, wikipedia, clinicaltrials, opentargets, npi
# (openalex = substituto do Google Scholar, que nao tem API e bloqueia scraping)
# As variaveis abaixo sao OPCIONAIS e so melhoram limites/etiqueta:
#   NCBI_API_KEY            -> eleva PubMed de 3 p/ 10 req/s (gratis: ncbi.nlm.nih.gov/account/settings)
#   SEMANTIC_SCHOLAR_API_KEY-> remove o HTTP 429 do Semantic Scholar (gratis: semanticscholar.org/product/api)
#   GOOGLE_BOOKS_API_KEY    -> Google Books confiavel (a quota anonima satura/429;
#                              gratis: console.cloud.google.com -> ativar "Books API" -> Credenciais)
#   LILO_RESEARCH_EMAIL     -> e-mail de contato (polidez/"polite pool" em PubMed/Crossref/OpenAlex)
#   LILO_WIKI_LANG          -> idioma da Wikipedia (default pt)
#   LILO_RESEARCH_TIMEOUT   -> timeout por chamada (s), default 15
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
GOOGLE_BOOKS_API_KEY=
LILO_RESEARCH_EMAIL=
LILO_WIKI_LANG=pt
LILO_RESEARCH_TIMEOUT=15

# ── Subagentes ───────────────────────────────────────────────
PDF_DIR=./PDFs_library/data

# ── Memoria persistente (KV SQLite v10.3) ────────────────────
# Caminho do banco SQLite. Default fica fora do OneDrive para evitar
# "disk I/O error" e locks de sync:
#   Windows: %LOCALAPPDATA%\LILO\memory\kv_memory.db
#   Unix:    ~/.local/share/lilo/memory/kv_memory.db
# Override:
# LILO_KV_MEMORY_DB=D:\dados\lilo\kv_memory.db

# ── Modos de execucao (V14, estilo Claude) ──────────────────
# Controla quanta confirmacao o LILO pede antes de AGIR (escrever/rodar):
#   plan         = so planeja, nao executa
#   ask          = confirma toda acao de risco (shell/python/write-fora-allowlist)
#   accept_edits = edita arquivos sem pedir; confirma shell/python
#   auto         = executa tudo (DEFAULT). No dashboard ha um seletor visual.
LILO_EXEC_MODE=auto

# ── Aproximacao ao Claude Code/Cowork (V15) ─────────────────
# Blocos de system prompt (honestidade/seguranca/estilo) -- KILL-SWITCH unico:
#   LILO_PROMPT_BLOCKS=1   (default; =0 desliga TODOS os blocos -> fallback)
# Eixo de ESTILO de resposta (apresentacao; ortogonal a roteamento/gating):
#   LILO_RESPONSE_STYLE=default   # default|concise|explanatory|formal (ver config/styles.yaml)
# Verificacao de qualidade OPT-IN (juiz LLM pos-Reporter; +1 chamada LLM):
#   LILO_QUALITY_CHECK=0   (default desligado; so complexity=complex; nunca bloqueia)
#   LILO_QUALITY_MIN=60    # escore minimo; abaixo dele faz UMA refinada extra
# Estagio VERIFY OPT-IN (roda codigo auto-contido do worker em sandbox isolado):
#   LILO_VERIFY_STAGE=0    (default desligado; so codigo stdlib sem IO; nao auto-corrige)
# Destilacao de fatos do historico (Ollama barato -> kv ns=user):
#   LILO_DISTILL_MODEL=    # default = modelo 'fast'; usado por chat_memory.distill_facts
# Scheduler do Cowork (FASE 5) -- executor de tarefas agendadas, DEFAULT-OFF e
# chamado SOB DEMANDA (scripts/run_scheduler.py via Task Scheduler/cron):
#   LILO_ENABLE_SCHEDULER=0   # =1 permite execucao real (senao so dry-run)
#   LILO_SCHEDULED_DIRS=      # dirs com */SKILL.md (separador ; Win / : Unix); ha defaults
#   # No SKILL.md: frontmatter 'schedule: hourly|daily|weekly|manual' + 'enabled: true'.
#   # Roda sob perfil 'cowork' (local-only, sem shell/python) + exec_mode ask;
#   # saidas em KVMemory ns 'lilo_tasks'. Ver docs/ROADMAP_claude_alignment.md.

# ── Microfone / voz->texto (STT local, V14.1) ───────────────
# Transcricao 100% local com faster-whisper (nenhum audio sai da maquina).
# Roda em CPU por padrao (nao usa a GPU). Modelo carregado lazy e cacheado.
# LILO_WHISPER_MODEL=base       # tiny|base|small|medium|large-v3
# LILO_WHISPER_DEVICE=cpu       # cpu | cuda
# LILO_WHISPER_COMPUTE=int8     # int8 | float16 | float32
# LILO_WHISPER_LANG=pt

# ── Reconhecimento de locutor (voice-ID, V14.6) ─────────────
# Biometria de voz LEVE (MFCC, sem torch) -- CONVENIENCIA, nao seguranca forte.
# NAO gateie acoes sensiveis so por voz. V14.6: score = cosseno ao centroide +
# limiar ADAPTATIVO (self_sim - margem), com piso abaixo. Voiceprint local e
# gitignored em data/voiceprint/; o formato antigo (V14.2) forca re-enroll.
# LILO_VOICE_THRESHOLD=0.80     # piso do limiar de cosseno
# LILO_VOICE_MARGIN=0.08        # folga subtraida da auto-similaridade do enrollment
# LILO_VOICEPRINT_DIR=          # default: <raiz>/data/voiceprint

# ── Desktop Commander (allow-list de paths) ──────────────────
# Tools fs_read/write/list/search e run_shell ficam restritas a estes paths.
# Separador: ; (Windows) ou : (Unix). Default: raiz do projeto LILO.
LILO_DESKTOP_ALLOW=C:\\Users\\luizd\\OneDrive\\Data_Science\\Projetos\\IA.agente;D:\\OneDrive\\Documentos\\Workaholics

# ── Villa_Lobos -- tiers por estagio (override via .env) ─────
# Cada estagio do pipeline (orchestrator/planner/reader/worker/reporter)
# resolve para um backend via Policy Engine. Valores aceitos:
#   ollama_fast | ollama_chat | ollama_plan | ollama_code | ollama_heavy
#   claude_haiku | claude_sonnet | claude_opus
# Defaults sao locais (Ollama). Para usar Claude no Reporter (qualidade
# em sintese), por exemplo:
#   VILLA_TIER_REPORTER=claude_haiku
# VILLA_TIER_ORCHESTRATOR=ollama_fast
# VILLA_TIER_PLANNER=ollama_plan
# VILLA_TIER_READER=ollama_code
# VILLA_TIER_WORKER=ollama_code
# VILLA_TIER_REPORTER=ollama_chat

# ── Villa_Lobos -- alavancas de QUALIDADE do Worker (V12.3) ──────────
# O gargalo de qualidade do LILO e a variancia factual do Worker local
# (modelo pequeno as vezes inventa). Alavancas para reduzir, todas medindo
# com o juiz (scripts/bench_semantic_domains.py --judge --repeat 5):
#
# 1) Temperatura (factualidade > criatividade em conhecimento):
LILO_WORKER_TEMP=0.25
LILO_WORKER_TEMP_CODE=0.4
#
# 2) Self-consistency: gera k respostas independentes e consolida o
#    corroborado (descarta o que aparece em 1 so -> menos invencao).
#    k=1 desliga (default). k=3 e um bom ponto de partida (custo: ~k+1 chamadas).
# LILO_WORKER_SC=3
#
# 3) Worker na NUVEM e o DEFAULT (V14.3): gpt-oss:120b-cloud. O experimento
#    2026-06-12 (juiz LLM) mostrou +107% de qualidade vs o 8b local, MESMO tempo.
#    Nao usa a GPU local (roda no Ollama Cloud); se o cloud falhar, ha fallback
#    automatico p/ o modelo local. Para forcar 100% LOCAL (offline/privacidade):
# VILLA_WORKER_GENERAL_MODEL=llama3.1:8b-instruct-q8_0
#    Juiz do bench tambem pode ser cloud (mais imparcial/forte):
# LILO_JUDGE_MODEL=gpt-oss:120b-cloud
#
# Liga/desliga as features de roteamento V12 (default ON):
# LILO_SEMANTIC_ROUTER=1     # porta unica de roteamento semantico
# LILO_STAGE_DELEGATION=1    # delegacao da etapa Worker a um especialista
# LILO_CHAIN_DELEGATION=1    # decomposicao em cadeia multi-especialista

# ── Subagente paper (redacao cientifica, V13) ────────────────────────
# Escritor do build_paper. Default cloud (NAO usa GPU local); para 100%
# local use llama3.1:8b-instruct-q8_0 (qualidade inferior). Idioma da
# Wikipedia e chaves de pesquisa ficam na secao "Pesquisa externa".
LILO_PAPER_MODEL=gpt-oss:120b-cloud

# ── Subagentes com modelo proprio (V18 QW7: agora documentados) ──────
# Defaults cloud (Ollama Cloud; NAO usam a GPU local nem passam pelo budget
# da Anthropic). Para 100% local, aponte p/ um modelo instalado no Ollama.
# LILO_SKILLSMITH_MODEL=gpt-oss:120b-cloud
# LILO_DOCGEN_MODEL=gpt-oss:120b-cloud
# LILO_REVIEW_MODEL=gpt-oss:120b-cloud
