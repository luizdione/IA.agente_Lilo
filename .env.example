# LILO v13 — configuracao minima (copie para .env e ajuste)

# --- Conexao com o Ollama ---------------------------------------------------
OLLAMA_HOST=http://localhost:11434
LLM_TIMEOUT=300                     # segundos por chamada
OLLAMA_KEEP_ALIVE=2h                # modelo quente entre chamadas

# --- Modelo -----------------------------------------------------------------
# qwen3 e a familia com tool-calling NATIVO confiavel no Ollama 0.32.x.
# (O template do qwen2.5-coder escreve a chamada como TEXTO — verificado com
# o exemplo canonico do Ollama; o proprio smoke detecta e avisa.)
LILO_MODEL=qwen3:14b                # ollama pull qwen3:14b (~9GB, cabe na 3060)
LILO_MODEL_FAST=qwen3:4b            # alternancia rapida via \modelo fast
# Janela de contexto: SEMPRE enviada (options.num_ctx). RTX 3060 12GB:
# 14b-q4 + 16k de KV fica APERTADO — use 8192 p/ 100% GPU, ou configure no
# servico do Ollama: OLLAMA_FLASH_ATTENTION=1 e OLLAMA_KV_CACHE_TYPE=q8_0.
LILO_NUM_CTX=16384
LILO_TEMP=0.2                       # baixa = tool calls mais confiaveis

# --- Agente -----------------------------------------------------------------
LILO_MODE=ask                       # plan | ask | accept_edits | auto
LILO_MAX_ITERS=25                   # teto de iteracoes do loop por tarefa
# Allow-list de diretorios que as tools de arquivo podem tocar.
# Separador: ";" no Windows, ":" no Linux/Mac. Fora dela = confirmacao extra.
LILO_ALLOW=C:\github;C:\projetos

# --- v13.1/v13.2 ------------------------------------------------------------
LILO_STREAM=1                       # resposta token a token no terminal (=0 desliga)
LILO_RESUMO=1                       # janela estourou -> resume o miolo via LLM fast (=0 so poda)
LILO_MEMORIA_EMBED=1                # busca SEMANTICA na memoria (=0 so LIKE)
LILO_MODEL_EMBED=mxbai-embed-large  # embedder (ollama pull mxbai-embed-large)
# Servidores MCP externos (tool `mcp`; allow-list explicita; dep opcional
# `pip install mcp`). Formato: nome=comando args;outro=comando args
# LILO_MCP=tempo=python -m servidor_tempo;fs=npx -y @modelcontextprotocol/server-filesystem C:\dados

# --- Avancado (opcional) ----------------------------------------------------
# LILO_SESSIONS_DB=                 # override do path do transcript
# LILO_MEMORIA_DB=                  # override da memoria memorizar/lembrar
#                                   # (defaults: %LOCALAPPDATA%\LILO\*.db)
