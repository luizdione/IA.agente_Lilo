# LILO v13 — configuracao minima (copie para .env e ajuste)

# --- Conexao com o Ollama ---------------------------------------------------
OLLAMA_HOST=http://localhost:11434
LLM_TIMEOUT=300                     # segundos por chamada
OLLAMA_KEEP_ALIVE=2h                # modelo quente entre chamadas

# --- Modelo -----------------------------------------------------------------
LILO_MODEL=qwen2.5-coder:14b        # default: melhor coder c/ tools que cabe na 3060
LILO_MODEL_FAST=qwen2.5-coder:7b-instruct   # alternancia rapida via \modelo fast
# Janela de contexto: SEMPRE enviada (options.num_ctx). RTX 3060 12GB:
# 14b-q4 + 16k de KV fica APERTADO — use 8192 p/ 100% GPU, ou configure no
# servico do Ollama: OLLAMA_FLASH_ATTENTION=1 e OLLAMA_KV_CACHE_TYPE=q8_0.
LILO_NUM_CTX=16384
LILO_TEMP=0.2                       # baixa = tool calls mais confiaveis

# --- Agente -----------------------------------------------------------------
LILO_MODE=ask                       # plan | ask | accept_edits | auto
LILO_MAX_ITERS=25                   # teto de iteracoes do loop por tarefa
# Allow-list de diretorios que as tools de arquivo podem tocar.
# Separador: ";" no Windows, ":" no Linux/Mac. Fora dela = confirmacao extra.
LILO_ALLOW=C:\github;C:\projetos

# --- Avancado (opcional) ----------------------------------------------------
# LILO_SESSIONS_DB=                 # override do path do transcript
#                                   # (default: %LOCALAPPDATA%\LILO\sessions.db)
