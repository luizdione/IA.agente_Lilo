# EditorConfig — LILO (https://editorconfig.org)
# Padroniza indentação e fim-de-linha entre editores; complementa .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # 2 espaços finais = quebra de linha em Markdown

# Scripts Windows precisam de CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
