model_list:
  # === MODELOS LOCAIS GRATUITOS (Ollama) — parque atual (ver shared/models.py) ===
  - model_name: chat
    litellm_params:
      model: ollama/gemma3:12b
      api_base: http://localhost:11434
      stream: true

  - model_name: code
    litellm_params:
      model: ollama/qwen2.5-coder:14b
      api_base: http://localhost:11434
      stream: true

  # === MODELOS PREMIUM (requer ANTHROPIC_API_KEY) ===
  # Atualizado 2026-05-07 para a familia Claude 4.x mais recente.
  - model_name: claude
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-sonnet
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-opus
    litellm_params:
      model: anthropic/claude-opus-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-haiku
    litellm_params:
      model: anthropic/claude-haiku-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

litellm_settings:
  # Logging
  set_verbose: false
  json_logs: true
  log_file: logs/litellm.log

  # Timeout e retries
  request_timeout: 120
  num_retries: 2

  # Fallback: se 'code' falhar, tenta 'chat'
  fallbacks:
    - code: [chat]

  # Cache para respostas (melhora performance)
  cache: true
  cache_params:
    type: local

general_settings:
  master_key: <DEFINIR_FORA_DO_GIT>
  database_url: null
