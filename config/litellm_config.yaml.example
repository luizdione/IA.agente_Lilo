model_list:
  # === MODELOS LOCAIS GRATUITOS (Ollama) ===
  - model_name: llama3
    litellm_params:
      model: ollama/llama3
      api_base: http://localhost:11434
      stream: true

  - model_name: codellama
    litellm_params:
      model: ollama/codellama
      api_base: http://localhost:11434
      stream: true

  # === MODELOS PREMIUM (requer ANTHROPIC_API_KEY) ===
  # Atualizado 2026-05-07 para a familia Claude 4.x mais recente.
  - model_name: claude
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-sonnet
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-opus
    litellm_params:
      model: anthropic/claude-opus-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

  - model_name: claude-haiku
    litellm_params:
      model: anthropic/claude-haiku-4-5
      api_key: <DEFINIR_FORA_DO_GIT>

litellm_settings:
  # Logging
  set_verbose: false
  json_logs: true
  log_file: logs/litellm.log

  # Timeout e retries
  request_timeout: 120
  num_retries: 2

  # Fallback: se codellama falhar, tenta llama3
  fallbacks:
    - codellama: [llama3]

  # Cache para respostas (melhora performance)
  cache: true
  cache_params:
    type: local

general_settings:
  master_key: <DEFINIR_FORA_DO_GIT>
  database_url: null
